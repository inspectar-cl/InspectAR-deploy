	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Configuración automática de timestamp para pruebas",
					"pm.globals.set('timestamp', new Date().toISOString());"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"packages": {},
				"exec": [
					"// Tests automáticos básicos",
					"pm.test('Status code is not 5xx', function () {",
					"    pm.expect(pm.response.code).to.be.below(500);",
					"});",
					"",
					"pm.test('Response time is acceptable', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});",
					"",
					"// Log del proxy para debug",
					"console.log('🌐 Gateway Response:', {",
					"    status: pm.response.code,",
					"    time: pm.response.responseTime + 'ms',",
					"    url: pm.request.url.toString()",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "GATEWAY_URL",
			"value": "http://localhost:3500",
			"description": "URL base del API Gateway"
		},
		{
			"key": "timestamp",
			"value": "",
			"description": "Timestamp automático para pruebas"
		}
	]
