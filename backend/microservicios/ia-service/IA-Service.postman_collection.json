				{
					"name": "Store Anomaly (Manual)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Anomaly was saved\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include(\"guardada exitosamente\");",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"});",
									"",
									"// Guardar el ID para usar en otras requests",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set(\"last_anomaly_id\", jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
